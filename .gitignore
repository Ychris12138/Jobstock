__pycache__/
*.pyc
config.json

# 岗位数据已改为纯本地个人数据，不再进 git（含自动历史版本 jobs/.history/）
jobs/

# sqlite 索引是派生数据，随时可重建。写成 **/ 是因为数据目录可能被配置到仓库子目录，
# 而含斜杠的模式只锚定在本文件所在目录。
**/data/*.db
**/data/*.db-*

# 个人投递状态：只属于本机
local/

# 跨进程锁文件：server 运行时创建，只属于本机
**/.jobs.lock
**/.server.lock

# CV 原文与解读：个人信息不上传
# 只保留 README.md（格式约定文档），其余一律挡掉
cv/*
!cv/README.md

# 清空/迁移数据前的整机备份目录
data-backup-*/

# 便携版构建产物与缓存（scripts/build_windows_portable.py）
build/
dist/

# 原子写留下的临时文件
*.tmp
.DS_Store

# 本地工具/临时截图噪音，不进仓库
.playwright-cli/
assets/screenshots/
assets/*.png
assets/*.html
assets/*.md
edited-*.png
generated-*.png

# README 展示用的正式截图（要进 git）
!assets/docs/
